# Rendered video output. These are large binaries regenerated by
# `npm run render:usecases` — the compositions in src/ are the source of truth.
out/

# Character reference stills generated per 00-WORKFLOW.md. Local to whoever runs
# the generation pass; the prompts that produce them are what's tracked.
prompts/refs/

# AI-generated live-action plates. Large binaries; drop them in locally and record
# the filename in src/usecases/scenarios.ts, which IS tracked.
public/plates/clips/

# Fallback stills are copied from src/assets/trip-covers by scripts/render-usecases.mjs
# at render time. Committing them would duplicate ~4MB already in the repo.
public/plates/stills/
